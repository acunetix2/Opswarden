{
  "version": "v1",
  "hooks": [
    {
      "name": "Scan for secrets when configuration files change",
      "trigger": "PostFileSave",
      "matcher": "(\\.env.*|.*\\.(json|jsonc|ya?ml|toml|ini))$",
      "action": {
        "type": "command",
        "command": "backend/.venv/Scripts/python.exe backend/scripts/scan_staged_secrets.py"
      },
      "timeout": 60
    }
  ]
}

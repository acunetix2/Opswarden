# Base URL of the OpsWarden FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8099

# Authentication: "local" (built-in, used for development and the demo accounts)
# or "supabase". Must match AUTH_PROVIDER on the backend.
NEXT_PUBLIC_AUTH_PROVIDER=local

# Supabase project (Project Settings > API). The anon / publishable key is safe in
# the browser. NEVER put the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hide the demo account list on the sign-in page (always hidden with Supabase)
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false

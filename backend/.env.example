# OpsWarden backend environment configuration
# Copy to .env and adjust. Never commit a real .env.

# App
OPSWARDEN_ENV=development
# Production: a random value of 32+ characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- Database ----------------------------------------------------------------
# Local: SQLite, zero setup.
DATABASE_URL=sqlite:///./opswarden.db
# Supabase Postgres (Project Settings > Database > Connection string > "Session pooler").
# Use the pooler on hosts without IPv6 (e.g. Render); the direct db.<ref>.supabase.co host is IPv6-only.
# postgres:// and postgresql:// URLs are converted to the psycopg driver automatically; TLS is added for Supabase.
# Copy the exact host from the dashboard: projects live on aws-0-... or aws-1-... poolers.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ---- Authentication ----------------------------------------------------------
# "local" = built-in email/password (development, tests, demo accounts).
# "supabase" = Supabase Auth issues tokens; this API verifies them and maps users by email.
AUTH_PROVIDER=local
SUPABASE_URL=
# Leave blank for projects using JWT signing keys (default for new projects; verified via JWKS).
# Only set for projects still on the legacy shared JWT secret.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# First admin on a fresh production database. With Supabase Auth only the email is needed:
# sign up in the app with that same email afterwards. With local auth also set a password,
# sign in once, then remove the password variable.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_WORKSPACE_NAME=OpsWarden

# ---- File storage --------------------------------------------------------------
# "local" (STORAGE_DIR, development) or "r2" (Cloudflare R2, production).
STORAGE_BACKEND=local
STORAGE_DIR=./_storage
MAX_UPLOAD_BYTES=15728640
# Cloudflare R2. Keep the bucket PRIVATE (no r2.dev public URL, no custom domain):
# the API streams documents to signed-in users, so nothing needs to be public.
# Account ID: R2 overview page, right-hand side.
# Keys: R2 > Manage API tokens > Create API token > "Object Read & Write", limited to this bucket.
# R2_JURISDICTION: leave blank, or "eu" ONLY for a bucket created with the EU jurisdiction
# (its S3 API URL then contains ".eu."). A wrong value gives "NoSuchBucket".
# Check with: python scripts/preflight_render.py https://your-frontend
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_JURISDICTION=
R2_PREFIX=documents/

# ---- Comparison tolerances --------------------------------------------------------
PRICE_TOLERANCE=0.01
QUANTITY_TOLERANCE=0

# ---- AI (optional) -------------------------------------------------------------
# Answers Warden's questions and rephrases supplier letters. Analysis and arithmetic never use it.
# Supported providers: groq, gemma (Google AI Studio), openai
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Google Gemini key for OCR (scans, photos, unfamiliar PDF layouts) and read-aloud.
GEMINI_API_KEY=
OCR_PROVIDER=gemini
OCR_MODEL=gemini-3.5-flash
TTS_PROVIDER=gemini
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Kore
LLM_MAX_CALLS_PER_HOUR=60
LLM_CACHE_TTL_SECONDS=3600
LLM_ERROR_COOLDOWN_SECONDS=60

# ---- Email (optional; Brevo) -------------------------------------------------------
# Without SMTP, approved emails are exported, never faked.
# Brevo: SMTP & API > SMTP. Username is the SMTP login (xxxx@smtp-brevo.com), password is an SMTP key.
# Render free instances block 587/465: use 2525.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ---- CORS ----------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000

# Demo seed data on startup (development only; ignored in production)
SEED_DEMO_DATA=true
